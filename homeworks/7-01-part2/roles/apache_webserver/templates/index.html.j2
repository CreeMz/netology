<!DOCTYPE html>
<html>
<head>
    <title>System Information</title>
    <style>
        body {
            font-family: monospace;
            margin: 40px;
            background: #f0f0f0;
        }
        .container {
            background: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
            max-width: 600px;
            margin: auto;
        }
        h1 {
            color: #2c3e50;
            border-bottom: 2px solid #3498db;
            padding-bottom: 10px;
        }
        .info {
            margin: 20px 0;
        }
        .label {
            font-weight: bold;
            color: #34495e;
            display: inline-block;
            width: 150px;
        }
        .value {
            color: #16a085;
            font-weight: bold;
        }
        .footer {
            margin-top: 30px;
            text-align: center;
            color: #7f8c8d;
            font-style: italic;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>System Information for {{ ansible_hostname }}</h1>
        
        <div class="info">
            <div><span class="label">CPU:</span> <span class="value">{{ ansible_processor[1] if ansible_processor[1] is defined else ansible_processor[0] }}</span></div>
            <div><span class="label">CPU Cores:</span> <span class="value">{{ ansible_processor_cores }}</span></div>
            <div><span class="label">RAM Total:</span> <span class="value">{{ (ansible_memtotal_mb / 1024) | round(2) }} GB</span></div>
            <div><span class="label">First HDD:</span> <span class="value">
                {%- set disk = ansible_mounts[0].device | basename -%}
                {{ ansible_devices[disk].size | default('N/A') }}
            </span></div>
            <div><span class="label">IP Address:</span> <span class="value">{{ ansible_default_ipv4.address }}</span></div>
            <div><span class="label">OS:</span> <span class="value">{{ ansible_distribution }} {{ ansible_distribution_version }}</span></div>
        </div>
        
        <div class="footer">
            Have a great day, System Administrator!
        </div>
    </div>
</body>
</html>
